<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android blocks plain http:// to any host by default since API 28.
         Profile-only (never merges into the real release build) — lets a
         profile build log in against a local backend over the LAN, the same
         case iOS needs NSAppTransportSecurity for (see the vault). -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
